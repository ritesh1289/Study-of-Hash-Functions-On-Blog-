    <script>
        const string = "hash";
        let hash = 0;
        let a = 63689;
        const b = 378551;
        let currentIndex = 0;
        function updateDisplay() {
            document.getElementById('hash-value').textContent = hash;
            document.getElementById('a-value').textContent = a;
            const stringDisplay = string.split('').map((c, i) =>
                i < currentIndex ? <span class="highlight">${c}</span> : c
            ).join(' ');
            document.getElementById('string-value').innerHTML = stringDisplay;
        }
        function stepAnimation() {
            if (currentIndex >= string.length) {
                clearInterval(animationInterval);
                return;
            }
            hash = hash * a + string.charCodeAt(currentIndex);
            a = a * b;
            currentIndex++;
            updateDisplay();
        }
        let animationInterval;
        function startAnimation() {
            if (animationInterval) clearInterval(animationInterval);
            currentIndex = 0;
            hash = 0;
            a = 63689;
            updateDisplay();
            animationInterval = setInterval(stepAnimation, 1000);
        }
        function resetAnimation() {
            if (animationInterval) clearInterval(animationInterval);
            currentIndex = 0;
            hash = 0;
            a = 63689;
            updateDisplay();
        }
    </script>
